# ── Nur für die Server-Version (npm run build:server / Docker) ──

# Passwort für die App (Pflicht). Empfänger-Links (/k/...) brauchen kein Passwort.
APP_PASSWORD=bitte-aendern

# Geheimer Schlüssel zum Signieren der Anmeldung (lange Zufallszeichenkette).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# KI – mindestens einen Schlüssel eintragen. Ist einer ausgelastet, wird der andere versucht.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# OPENROUTER_MODEL=openrouter/free
# AI_PROVIDER=gemini

# Speicherort der Datenbank
DATABASE_PATH=./data/funkelpost.db

# Nur nötig, wenn der Server ohne HTTPS läuft (z. B. im Heimnetz): sonst greift das Login-Cookie nicht.
# COOKIE_SECURE=false
