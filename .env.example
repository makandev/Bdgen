# Passwort für den Editor (Pflicht). Empfänger-Links (/k/...) brauchen kein Passwort.
APP_PASSWORD=bitte-aendern

# Geheimer Schlüssel zum Signieren der Login-Session (lange Zufallszeichenkette).
# Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# KI-Anbieter: "gemini" oder "openrouter". Leer = automatisch (der, für den ein Schlüssel da ist).
# Ist ein Anbieter ausgelastet (Free-Tier-Limit), wird automatisch der andere versucht.
AI_PROVIDER=

# Google Gemini (kostenloser API-Schlüssel: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenRouter (https://openrouter.ai/keys) – "openrouter/free" wählt automatisch ein kostenloses Modell
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional: anderer OpenAI-kompatibler Endpunkt
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Speicherort der SQLite-Datenbank
DATABASE_PATH=./data/bdgen.db
