{
  "name": "funkelpost",
  "version": "0.1.0",
  "private": true,
  "description": "Persönliche, KI-gestützte Überraschungskarten – als Browser-App (GitHub Pages) oder mit eigenem Server",
  "scripts": {
    "dev": "next dev",
    "dev:server": "NEXT_PUBLIC_MODE=server next dev",
    "build": "next build",
    "build:server": "NEXT_PUBLIC_MODE=server next build",
    "start:server": "NEXT_PUBLIC_MODE=server next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.5"
  }
}
